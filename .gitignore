# Godot 4+ specific ignores
.godot/
/android/

# Build / export output
/export/
export_presets.cfg.bak

# Local npm cache (used when global cache is unavailable in sandboxed sessions)
.npm-cache/
reference/html-proto/.npm-cache/

# Editor / OS noise
*.tmp
*.import.bak
.DS_Store
Thumbs.db

# Claude Code per-user local settings (permission grants, etc.).
# Project-shared Claude settings (.claude/settings.json) ARE committable.
.claude/settings.local.json

# Claude Code worktrees (each holds a full repo copy — never commit).
.claude/worktrees/

# Python bytecode cache.
__pycache__/
*.pyc

# Never commit credentials (a pixellab token lived here 2026-05-21..07-02; key rotated)
.claude/skills/magiclike-card-art/pixellab-token
